# Xcode project is generated from project.yml via XcodeGen
Phren.xcodeproj/
xcuserdata/
*.xcuserstate
DerivedData/
.build/
*.xcresult
.swiftpm/

# Test .xcresult bundles and attachments from scripts/worker-build.sh
# (the default when PHREN_RESULTS_DIR is unset)
.scratch/

# Entitlements + both targets' Info.plists are generated by
# `xcodegen generate` from project.yml's entitlements:/info: blocks.
Phren/Phren.entitlements
Phren/Info.plist
PhrenWidgets/Info.plist
PhrenWidgets/PhrenWidgets.entitlements

# Generated by scripts/bundle-graph.mjs — the minified renderer
Phren/Resources/graph/phren-graph.js

# Personal signing config — never commit a Team ID
Local.xcconfig
Local.deploy.json
