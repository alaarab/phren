{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", "scripts/build.mjs", "scripts/build-code.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "phren-vscode#build": {
      "dependsOn": ["@phren/cli#build"],
      "outputs": ["out/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
