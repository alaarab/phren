{
  "name": "phren",
  "displayName": "phren",
  "description": "Long-term memory for Claude Code. Recalls relevant past findings on every prompt, keeps per-project context, and saves what each session learned to a local git-backed store you own. No account, no telemetry by default.",
  "version": "0.3.6",
  "author": {
    "name": "Ala Arab",
    "url": "https://github.com/alaarab"
  },
  "repository": "https://github.com/alaarab/phren",
  "license": "MIT",
  "homepage": "https://alaarab.github.io/phren/",
  "keywords": [
    "memory",
    "long-term-memory",
    "persistent-memory",
    "context",
    "knowledge-base",
    "project-context",
    "tasks",
    "findings",
    "local-first",
    "git",
    "mcp",
    "hooks",
    "skills"
  ],
  "skills": [
    "./packages/cli/starter/global/skills/phren-init",
    "./packages/cli/starter/global/skills/phren-sync",
    "./packages/cli/starter/global/skills/phren-discover",
    "./packages/cli/starter/global/skills/phren-consolidate",
    "./packages/cli/starter/global/skills/phren-summarize",
    "./packages/cli/starter/global/skills/phren-profiles"
  ],
  "mcpServers": {
    "phren": {
      "command": "npx",
      "args": ["-y", "@phren/cli@0.3.6", "mcp"],
      "env": {
        "PHREN_MCP_OWNER": "plugin"
      }
    }
  }
}
