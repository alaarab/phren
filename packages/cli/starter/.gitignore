.DS_Store
*.swp
.runtime/
.sessions/
.cache/

# Feature flags and API keys. `phren init` writes this file itself
# (ensureDefaultFeatureFlags), and docs/environment.md tells users to put
# OPENAI_API_KEY / ANTHROPIC_API_KEY / PHREN_LLM_KEY in it — so on a synced
# store the very next `git add -A` would push them.
.env

# Key material a user may have dropped into the store directory.
*.pem
*.key

# Legacy location for auth/profiles.ts's credential store (API keys, OpenAI
# Codex OAuth tokens). It now lives in .runtime/ (already ignored above) —
# this stays here so a store created before that move, or one where the
# migration hasn't run yet, never has its credentials committed.
.config/auth-profiles.json
