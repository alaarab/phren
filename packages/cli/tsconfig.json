{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    // Catches a block that can never run — how the team-store commit/push in
    // push_changes sat dead behind a try/catch whose every path returned, while
    // the tool reported "Pushed to remote".
    "allowUnreachableCode": false,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/__tests__/**/*", "src/test-helpers.ts"]
}
