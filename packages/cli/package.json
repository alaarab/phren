{
  "name": "@phren/cli",
  "version": "0.3.1",
  "description": "Knowledge layer for AI agents - CLI, MCP server, and data layer",
  "type": "module",
  "bin": {
    "phren": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/phren-paths.d.ts",
      "default": "./dist/phren-paths.js"
    },
    "./runtime-profile": {
      "types": "./dist/runtime-profile.d.ts",
      "default": "./dist/runtime-profile.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./shared/retrieval": {
      "types": "./dist/shared/retrieval.d.ts",
      "default": "./dist/shared/retrieval.js"
    },
    "./shared/content": {
      "types": "./dist/shared/content.d.ts",
      "default": "./dist/shared/content.js"
    },
    "./shared/governance": {
      "types": "./dist/shared/governance.d.ts",
      "default": "./dist/shared/governance.js"
    },
    "./skill/registry": {
      "types": "./dist/skill/registry.d.ts",
      "default": "./dist/skill/registry.js"
    },
    "./cli/extract": {
      "types": "./dist/cli/extract.d.ts",
      "default": "./dist/cli/extract.js"
    },
    "./store-routing": {
      "types": "./dist/store-routing.d.ts",
      "default": "./dist/store-routing.js"
    },
    "./data/access": {
      "types": "./dist/data/access.d.ts",
      "default": "./dist/data/access.js"
    },
    "./data/tasks": {
      "types": "./dist/data/tasks.d.ts",
      "default": "./dist/data/tasks.js"
    },
    "./data/notes": {
      "types": "./dist/data/notes.d.ts",
      "default": "./dist/data/notes.js"
    },
    "./core/finding": {
      "types": "./dist/core/finding.d.ts",
      "default": "./dist/core/finding.js"
    },
    "./core/note": {
      "types": "./dist/core/note.d.ts",
      "default": "./dist/core/note.js"
    },
    "./auth/profiles": {
      "types": "./dist/auth/profiles.d.ts",
      "default": "./dist/auth/profiles.js"
    },
    "./session/utils": {
      "types": "./dist/session/utils.d.ts",
      "default": "./dist/session/utils.js"
    },
    "./session/artifacts": {
      "types": "./dist/session/artifacts.d.ts",
      "default": "./dist/session/artifacts.js"
    },
    "./shell/render-api": {
      "types": "./dist/shell/render-api.d.ts",
      "default": "./dist/shell/render-api.js"
    },
    "./shell/intro": {
      "types": "./dist/shell/intro.d.ts",
      "default": "./dist/shell/intro.js"
    },
    "./phren-art": {
      "types": "./dist/phren-art.d.ts",
      "default": "./dist/phren-art.js"
    },
    "./code-host/project-config": {
      "types": "./dist/project-config.d.ts",
      "default": "./dist/project-config.js"
    },
    "./code-host/phren-paths": {
      "types": "./dist/phren-paths.d.ts",
      "default": "./dist/phren-paths.js"
    },
    "./code-host/utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./code-host/governance/locks": {
      "types": "./dist/governance/locks.d.ts",
      "default": "./dist/governance/locks.js"
    },
    "./code-host/logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./code-host/index-query": {
      "types": "./dist/index-query.d.ts",
      "default": "./dist/index-query.js"
    },
    "./code-host/utils-paths": {
      "types": "./dist/utils-paths.d.ts",
      "default": "./dist/utils-paths.js"
    },
    "./code-host/shared/sqljs": {
      "types": "./dist/shared/sqljs.d.ts",
      "default": "./dist/shared/sqljs.js"
    },
    "./code-host/data/access": {
      "types": "./dist/data/access.d.ts",
      "default": "./dist/data/access.js"
    },
    "./code-host/content/summarize": {
      "types": "./dist/content/summarize.d.ts",
      "default": "./dist/content/summarize.js"
    }
  },
  "files": [
    "dist",
    "plugins",
    "starter",
    "skills",
    "scripts/preuninstall.mjs"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "lint": "biome lint --config-path ../../biome.json src/",
    "test": "echo 'Run tests from repo root: pnpm -w test'",
    "preuninstall": "node scripts/preuninstall.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "chalk": "^6.0.0",
    "glob": "^13.0.6",
    "inquirer": "^14.2.2",
    "js-yaml": "^5.4.2",
    "sql.js-fts5": "^1.4.0",
    "uqr": "0.1.3",
    "ws": "8.21.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "memory",
    "knowledge"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alaarab/phren.git",
    "directory": "packages/cli"
  },
  "devDependencies": {
    "3d-force-graph": "^1.80.0",
    "@phren/code": "workspace:*",
    "@types/ws": "8.18.1",
    "three": "^0.186.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
