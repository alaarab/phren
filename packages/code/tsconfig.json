{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@phren/cli/code-host/*": [
        "../cli/src/*"
      ],
      "@phren/code": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/__tests__/**/*",
    "src/test-helpers.ts",
    "src/**/__fixtures__/**"
  ]
}
